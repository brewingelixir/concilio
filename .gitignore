# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
concilio-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# `mix phx.digest` output: hash-suffixed and gzipped sibling files.
# The originals (favicon.ico, robots.txt, images/logo.svg) stay
# tracked; the digester regenerates these on every `mix assets.deploy`.
/priv/static/**/*-????????????????????????????????.*
/priv/static/**/*.gz

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Dialyzer PLT files
/priv/plts/

# Local auth token + SQLite data dir (when CONCILIO_DATA_DIR points
# inside the repo) written at first boot (mode 0600)
/.concilio/

# SQLite dev/test databases (and WAL/SHM sidecars) live in priv/repo
/priv/repo/*.db
/priv/repo/*.db-wal
/priv/repo/*.db-shm

# Dev runtime data dir (auth_token + secrets/) — separate from prod's
# `~/.concilio/` so envs don't share state.
/priv/.dev/

# Local env overrides (never read by Claude per global rule)
.env
.env.local
.env.*.local

# Claude Code local state (machine-specific; not shared)
.claude/scheduled_tasks.lock
.claude/settings.local.json
